% -------------------------------------------------------------- utilities
% A caption line under a figure, in the deck's quiet grey.
\newcommand{\lccap}[1]{{\footnotesize\color{lcgrey}#1}}
% The result, wherever it needs to be shouted.
\newcommand{\lcnum}[1]{{\color{lcaccent}\bfseries #1}}
% A framed pull-quote, used for the "I believe" sentence and its kin.
\newcommand{\lcquote}[2]{%
  \begin{tikzpicture}
    \node[fill=lcpale,draw=lcmid,line width=0.8pt,rounded corners=3pt,
      inner sep=9pt,text width=\dimexpr\textwidth-30pt\relax,align=center]
      (q) {#1};
    \node[anchor=north east,text=lcgrey,font=\scriptsize]
      at ($(q.south east)+(0,-2pt)$) {#2};
  \end{tikzpicture}%
}
% A screenshot slot that renders the image if present and a labelled
% placeholder if not, so the deck always compiles.  #1 width, #2 path,
% #3 what to capture.
\newcommand{\lcshot}[3]{%
  \IfFileExists{#2}{\includegraphics[width=#1]{#2}}{%
    \begin{tikzpicture}
      \node[draw=lcmid,line width=0.8pt,dashed,rounded corners=3pt,
        fill=lcpaled,inner sep=6pt,minimum height=3.2cm,
        text width=\dimexpr#1-16pt\relax,align=center,
        font=\scriptsize,text=lcgrey] {#3};
    \end{tikzpicture}}%
}

% The diagrams, last: they use the palette and the vocabulary above.
\RequirePackage{lcfigures}

