% A pawn silhouette, drawn in board-square units and centred on (#1,#2) so
% it can be dropped onto any of the board pictures below.  #3 is the fill,
% #4 the outline --- a light pawn needs one, a dark pawn does not.
\newcommand{\lcpawn}[4]{%
  \begin{scope}[shift={(#1,#2)},fill=#3,draw=#4,line width=0.28pt]
    \filldraw (0,0.13) circle (0.115);
    \filldraw (-0.15,-0.20) -- (-0.065,-0.02) -- (0.065,-0.02)
              -- (0.15,-0.20) -- cycle;
    \filldraw (-0.20,-0.26) rectangle (0.20,-0.19);
  \end{scope}}

% An empty board, small enough to use as an icon.  #1 is the square size.
\newcommand{\lcminiboard}[1]{%
\begin{tikzpicture}[x=#1,y=#1,baseline=-0.5mm]
  \foreach \r in {0,...,7}{\foreach \c in {0,...,7}{
    \pgfmathtruncatemacro{\lcq}{mod(\r+\c,2)}
    \ifnum\lcq=0
      \fill[lcpaled] (\c,\r) rectangle ++(1,1);
    \else
      \fill[lcmid!45] (\c,\r) rectangle ++(1,1);
    \fi}}
  \draw[lcgrey,line width=0.3pt] (0,0) rectangle (8,8);
\end{tikzpicture}}

