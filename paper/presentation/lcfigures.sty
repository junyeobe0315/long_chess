% ========================================================================
% 3. Parity, drawn in the same idiom as the clock so the two slides read as
% one argument.  Each panel is one segment: the clock climbs, and the strip
% under the axis is the colour of each ply.  Since plies alternate, the
% colour of the last one is fixed by the length's parity --- so a segment
% whose two endpoints differ in colour cannot have length 150.
% ========================================================================
% #1 is a vertical offset in clock units, added to every y coordinate.  It
% is done this way rather than with a scope because a \foreach inside a
% scope inside a macro leaves TikZ unable to close the scope --- the failure
% surfaces as an undefined \tikzscope@linewidth from wherever the next path
% happens to be.
\newcommand{\lc@parity}[3]{% #1 y-offset, #2 segment length, #3 note
  \draw[lcaccent,dashed,line width=0.5pt] (-16,{150+#1}) -- (168,{150+#1});
  \node[anchor=east,font=\tiny,text=lcaccent] at (-17,{150+#1}) {150};
  \draw[lcgrey,line width=0.4pt] (-16,{0+#1}) -- (168,{0+#1});
  % the clock over one segment: up one per quiet ply, reset by the last
  \draw[lcdark,line width=0.9pt]
    (0,{0+#1}) -- ({#2-1},{#2-1+#1}) -- (#2,{0+#1});
  % the plies themselves, in their true colours: the previous endpoint,
  % then the last six of the segment
  \path[segB] (-16,{-34+#1}) rectangle ++(9,20);
  \node[anchor=north,font=\tiny,text=lcgrey] at (-11.5,{-38+#1}) {$e_{i-1}$};
  \node[font=\tiny,text=lcgrey] at (55,{-24+#1}) {$\cdots$};
  % The style name is computed rather than branched on: a \fi sitting
  % immediately after a path's semicolon is read by TikZ's look-ahead.
  \foreach \k in {0,...,5}{
    \pgfmathtruncatemacro{\lcj}{#2-5+\k}
    \pgfmathtruncatemacro{\lcpar}{mod(\lcj,2)}
    \edef\lcsty{\ifnum\lcpar=1 W\else B\fi}
    \path[seg\lcsty] ({108+\k*10},{-34+#1}) rectangle ++(9,20);}
  \draw[lcaccent,line width=0.8pt]
    (156.6,{-35.6+#1}) rectangle (167.4,{-12.4+#1});
  \node[anchor=north,font=\tiny,text=lcaccent] at (162,{-38+#1}) {$e_i$};
  \node[anchor=west,font=\scriptsize,align=left] at (182,{60+#1}) {#3};}

% The notes are built here rather than written inline.  Note that each \\
% stands at the outer level: a \\ nested inside a group --- \textcolor{...}
% wrapped around both lines, say --- breaks a TikZ node's align machinery,
% and the error it produces names neither the node nor this file.
\newcommand{\lc@parityA}{%
  \lcsSameColour\\ $\Rightarrow$ \lcsEven\ $\Rightarrow$ \textbf{150}}
\newcommand{\lc@parityB}{%
  \textcolor{lcaccent}{\lcsDiffColour}\\
  \textcolor{lcaccent}{$\Rightarrow$ \lcsOdd\ $\Rightarrow$ \textbf{149}}}
\newcommand{\figparity}{%
\begin{tikzpicture}[x=0.052cm,y=0.0112cm,font=\scriptsize]
  \lc@parity{262}{150}{\lc@parityA}
  \lc@parity{0}{149}{\lc@parityB}
\end{tikzpicture}}

