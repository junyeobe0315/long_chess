% ========================================================================
% 6. The pawn-move budget as a grid: sixteen pawns, six moves each.
% \figpawngrid{lost per pawn}{how many pawns}{what P drops to}
% ========================================================================
\newcommand{\figpawngrid}[3]{%
\begin{tikzpicture}[x=1mm,y=1mm,font=\tiny]
  \foreach \p in {0,...,15}{
    \pgfmathtruncatemacro{\isblack}{\p<8 ? 0 : 1}
    \foreach \m in {0,...,5}{
      \pgfmathtruncatemacro{\lost}{(\p>=(8-#2) && \p<8 && \m>=(6-#1)) ? 1 : 0}
      \ifnum\lost=1
        \path[fill=lcpaled,draw=lcgrey,line width=0.2pt]
          ({\p*5.4},{\m*3.6}) rectangle ++(4.6,3.1);
        \draw[lcaccent,line width=0.45pt]
          ({\p*5.4+0.7},{\m*3.6+0.6}) -- ({\p*5.4+3.9},{\m*3.6+2.5});
        \draw[lcaccent,line width=0.45pt]
          ({\p*5.4+3.9},{\m*3.6+0.6}) -- ({\p*5.4+0.7},{\m*3.6+2.5});
      \else
        \ifnum\isblack=1
          \path[segB] ({\p*5.4},{\m*3.6}) rectangle ++(4.6,3.1);
        \else
          \path[segW] ({\p*5.4},{\m*3.6}) rectangle ++(4.6,3.1);
        \fi
      \fi}}
  % a pawn over each column, so the grid reads as "one pawn, six moves"
  \foreach \p in {0,...,15}{
    \ifnum\p<8
      \begin{scope}[shift={({\p*5.4+2.3},25.4)},x=4mm,y=4mm]
        \lcpawn{0}{0}{white}{lcdark}\end{scope}
    \else
      \begin{scope}[shift={({\p*5.4+2.3},25.4)},x=4mm,y=4mm]
        \lcpawn{0}{0}{lcdark}{lcdark}\end{scope}
    \fi}
