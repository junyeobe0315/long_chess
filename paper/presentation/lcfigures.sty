% lcfigures.sty — the talk's diagrams.
%
% Loaded by longchess.sty (after the palette and the \lcs* vocabulary, both
% of which the pictures use).  Every figure is a single macro so the slides
% stay one line long, and every label goes through \lcs*, so the Korean and
% English decks draw the same pictures.
%
% The segment diagrams are drawn from assets/segments.tex, which
% make_assets.py derives from data/longest.pgn: 118 segments, their real
% endpoint colours, and the real kind of critical move ending each.  The
% picture is therefore of the actual reference game, not a schematic.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lcfigures}[2026/08/07 Diagrams for the long-chess talk]

\RequirePackage{pifont}

% ------------------------------------------------------------- real data
% Fallbacks keep the deck compiling before make_assets.py has ever run.
\IfFileExists{assets/segments.tex}{\input{assets/segments.tex}}{%
  \def\lcsegrunlist{B/1/10,W/11/59,B/60/109,W/110/118}
  \def\lcsegdata{B/pawn,W/pawn,B/cap,W/term}
  \def\lcsegcount{118}\def\lcsegplies{17697}\def\lcsegpattern{BWBW}
  \def\lcsegruns{B10, W49, B50, W9}\def\lcsegshort{11, 60, 110}
  \def\lcsegnshort{3}\def\lcsegpawn{96}\def\lcsegcap{29}
  \def\lcsegboth{8}\def\lcsegterm{1}\def\lcsegnruns{4}%
}

