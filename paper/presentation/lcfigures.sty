    (0,23.5) -- (42.2,23.5);
  \node[anchor=south,font=\tiny,text=lcdark] at (21,29.5)
    {8 \lcsWhite\ \lcsPawns};
  \draw[lcmid,line width=0.5pt,decorate,decoration={brace,amplitude=2.4pt}]
