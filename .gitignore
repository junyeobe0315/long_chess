__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Verification traces: regenerate with
#   uv run python -m long_chess.verifier <pgn> --trace <out>
*.trace.tsv
*.trace.jsonl

# LaTeX build artifacts under paper/ — only the PDFs (and sources) belong
# in the repo; tectonic leaves none of these, latexmk/pdflatex do
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.nav
paper/**/*.out
paper/**/*.snm
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.vrb
paper/**/*.xdv
